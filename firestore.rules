rules_version = '2';
// PE Element-Etiketten – Firestore-Regeln
// Zugriff NUR für angemeldete Büro-Konten (E-Mail/Passwort) mit Eintrag rollen/{uid} = {rolle:'buero'}.
// Die Rolle wird nur von Hand in der Firebase-Konsole gesetzt, nie vom Browser.
// Baustelle (QR-Code) und Monteure greifen NICHT auf die Datenbank zu, sondern über den Cloudflare Worker
// (Service-Konto, nur das eine Element zum Etiketten-Schlüssel). Anonyme Anmeldung ist abgeschaltet.
service cloud.firestore {
  match /databases/{database}/documents {
    function buero() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && get(/databases/$(database)/documents/rollen/$(request.auth.uid)).data.rolle == 'buero';
    }
    match /rollen/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{coll}/{id} {
      allow read, write: if coll in ['objekte', 'plaene', 'elemente', 'settings', 'zugaenge'] && buero();
    }
    // Alte Dateien aus der Demo-Zeit (werden automatisch nach Dropbox übertragen und dann gelöscht)
    match /dateien/{d=**} {
      allow read, write: if buero();
    }
  }
}
